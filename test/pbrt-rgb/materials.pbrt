# Material preview regression: separate leaf models and nested textured mixes.
LookAt 0 0 6  0 0 0  0 1 0
Camera "perspective" "float fov" 50
Film "rgb" "integer xresolution" 640 "integer yresolution" 640
WorldBegin
Texture "pixels" "spectrum" "imagemap" "string filename" "pixels.pnm" "string encoding" "linear" "string filter" "point"
Texture "weight" "float" "checkerboard" "float tex1" 0.2 "float tex2" 0.8 "float uscale" 4 "float vscale" 8
MakeNamedMaterial "paint" "string type" "diffuse" "texture reflectance" "pixels"
MakeNamedMaterial "metal" "string type" "conductor" "rgb eta" [1.2 1.5 1.8] "rgb k" [2.8 2.1 1.4]
MakeNamedMaterial "transmission" "string type" "diffusetransmission" "rgb reflectance" [0.2 0.1 0.05] "rgb transmittance" [0.1 0.4 0.2] "float scale" 0.8
MakeNamedMaterial "subsurface" "string type" "subsurface" "rgb sigma_a" [0.1 0.5 0.8] "rgb sigma_s" [0.6 0.2 0.4]
MakeNamedMaterial "absorption" "string type" "hair" "rgb sigma_a" [0.2 0.5 1.0]
MakeNamedMaterial "pigments" "string type" "hair" "texture eumelanin" "weight" "float pheomelanin" 0.6
MakeNamedMaterial "inner" "string type" "mix" "string materials" ["paint" "metal"] "texture amount" "weight"
MakeNamedMaterial "outer" "string type" "mix" "string materials" ["inner" "absorption"] "float amount" 0.3
AttributeBegin
Translate -2.4 0 0
NamedMaterial "paint"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Translate -1.5999999999999999 0 0
NamedMaterial "metal"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Translate -0.7999999999999998 0 0
NamedMaterial "transmission"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Translate 4.440892098500626E-16 0 0
NamedMaterial "subsurface"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Translate 0.8000000000000003 0 0
NamedMaterial "absorption"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Translate 1.6 0 0
NamedMaterial "pigments"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
AttributeEnd
AttributeBegin
Translate 2.400000000000001 0 0
NamedMaterial "outer"
Shape "trianglemesh" "point3 P" [-0.35 -1.8 0  0.35 -1.8 0  0.35 1.8 0  -0.35 1.8 0]
    "point2 uv" [0 0 1 0 1 1 0 1] "integer indices" [0 1 2 0 2 3]
